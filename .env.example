APP_ENV=development
HTTP_ADDR=:8080
HTTP_REQUEST_TIMEOUT=10s

# Turso Cloud credentials. Use a libsql:// or https:// database URL.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=replace-me

# Lambda processes one request at a time per execution environment.
# Keep this at 1 unless you have a different concurrency model.
DB_MAX_OPEN_CONNS=1
DB_MAX_IDLE_CONNS=1
DB_CONN_MAX_LIFETIME=5m
